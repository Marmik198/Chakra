{
 "name": "chakra",
 "version": "0.1.0",
 "private": true,
 "scripts": {
  "dev": "next dev",
  "build": "next build",
  "start": "next start",
  "mobile:export": "cross-env MOBILE=1 next build",
  "mobile:add": "npm run mobile:export && cap add android && node scripts/patch-android.mjs",
  "mobile:sync": "npm run mobile:export && cap sync android",
  "mobile:open": "cap open android",
  "mobile:run": "cap run android",
  "assets": "capacitor-assets generate --android",
  "analyze": "cross-env ANALYZE=true next build"
 },
 "dependencies": {
  "next": "14.2.15",
  "react": "^18.3.1",
  "react-dom": "^18.3.1",
